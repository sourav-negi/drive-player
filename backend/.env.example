# Google Drive OAuth (get these by running: python get_refresh_token.py)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=1//your-refresh-token

# Optional: scope to a specific folder (default: root)
GOOGLE_DRIVE_FOLDER_ID=root

# CORS origins (comma-separated, no spaces)
# Render sets the PORT env var automatically — do not hardcode it here.
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
